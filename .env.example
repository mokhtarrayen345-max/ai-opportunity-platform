NODE_ENV=development
NEXT_PUBLIC_APP_NAME=AI Opportunity Platform

# Server-side PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_opportunity_platform

# AI provider configuration (server-side).
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# GitHub App authorization (server-side only; never expose these to the browser or AI).
# Configure a GitHub App with Request user authorization (OAuth) during installation.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=http://localhost:3000/api/github/authorization/callback
# Additional application allowlist. Use owner/repository entries, comma-separated.
GITHUB_ALLOWED_REPOSITORIES=
# Keep real repair writes disabled by default.
GITHUB_REPAIR_EXECUTION_ENABLED=false
GITHUB_REPOSITORY_PROVIDER_ENABLED=false
