generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String?
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     Session[]
  analyses     AnalysisRecord[]
  solverRuns   SolverRecord[]
  opportunities OpportunityRecord[]

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AnalysisRecord {
  id           String   @id @default(cuid())
  userId       String
  itemId       String
  opportunity  String
  confidence   Int
  whyItMatters String
  nextSteps    Json
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, itemId])
}

model SolverRecord {
  id        String   @id @default(cuid())
  userId    String
  problem   String
  summary   String
  steps     Json
  risks     Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model OpportunityRecord {
  id String @id @default(cuid())
  userId String
  input String
  title String
  shortSummary String
  problemStatement String
  targetUsers Json
  marketDomain String
  painSeverity Int
  demandSignals Json
  existingAlternatives Json
  proposedSolutionDirection String
  monetizationPossibilities Json
  estimatedDifficulty Int
  technicalFeasibility Int
  businessPotential Int
  risks Json
  assumptions Json
  unknowns Json
  recommendedNextStep String
  dimensionScores Json
  dimensionExplanations Json
  overallScore Int
  confidence Int
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt])
  @@index([userId,overallScore])
}
