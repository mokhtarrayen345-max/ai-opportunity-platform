generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String?
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     Session[]
  analyses     AnalysisRecord[]
  solverRuns   SolverRecord[]
  opportunities OpportunityRecord[]
  intelligenceSignals IntelligenceSignal[]
  sources Source[]
  discoveredProblems DiscoveredProblem[]
  prospects Prospect[]
  problemEvidence ProblemEvidence[]
  sourceIntelligenceReviews SourceIntelligenceReview[]
  diagnosisTargets DiagnosisTarget[]
  diagnosisRuns DiagnosisRun[]
  diagnosticFindings DiagnosticFinding[]
  repairPlans RepairPlan[]
  authorizedRepositories AuthorizedRepository[]
  githubAuthorizationStates GithubAuthorizationState[]
  repairExecutions RepairExecution[]
  repairReviews RepairReview[]

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AnalysisRecord {
  id           String   @id @default(cuid())
  userId       String
  itemId       String
  opportunity  String
  confidence   Int
  whyItMatters String
  nextSteps    Json
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, itemId])
}

model SolverRecord {
  id        String   @id @default(cuid())
  userId    String
  problem   String
  summary   String
  steps     Json
  risks     Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model OpportunityRecord {
  id String @id @default(cuid())
  userId String
  input String
  title String
  shortSummary String
  problemStatement String
  targetUsers Json
  marketDomain String
  painSeverity Int
  demandSignals Json
  existingAlternatives Json
  proposedSolutionDirection String
  monetizationPossibilities Json
  estimatedDifficulty Int
  technicalFeasibility Int
  businessPotential Int
  risks Json
  assumptions Json
  unknowns Json
  recommendedNextStep String
  dimensionScores Json
  dimensionExplanations Json
  overallScore Int
  confidence Int
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt])
  @@index([userId,overallScore])
  discoveredProblem DiscoveredProblem?
}


model IntelligenceSignal {
  id String @id @default(cuid())
  userId String
  title String
  summary String
  sourceType String
  sourceName String
  sourceUrl String?
  externalId String?
  detectedAt DateTime
  receivedAt DateTime
  topic String
  entities Json
  signalType String
  rawContent String
  rawReference String?
  normalizedContent String
  sourceFacts Json
  aiInterpretation Json
  assumptions Json
  unknowns Json
  confidence Int
  metadata Json
  fingerprint String
  opportunityAnalysisStatus String @default("not_analyzed")
  lastOpportunityAnalyzedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,fingerprint])
  @@index([userId,sourceType,createdAt])
  @@index([userId,receivedAt])
  @@index([userId,topic])
  @@index([userId,signalType])
}


model Source {
  id String @id
  userId String
  name String
  type String
  enabled Boolean @default(true)
  status String @default("UNKNOWN")
  description String
  config Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  health SourceHealth?
  @@unique([userId,name])
  @@index([userId,enabled])
  @@index([userId,type])
}

model SourceHealth {
  id String @id @default(cuid())
  sourceId String @unique
  lastCheckAt DateTime?
  lastSuccessAt DateTime?
  totalChecks Int @default(0)
  totalFailures Int @default(0)
  lastError String?
  latencyMs Int?
  healthScore Int @default(0)
  status String @default("UNKNOWN")
  updatedAt DateTime @updatedAt
  source Source @relation(fields:[sourceId],references:[id],onDelete:Cascade)
  @@index([status])
  @@index([updatedAt])
}


model DiscoveredProblem {
  id String @id @default(cuid())
  userId String
  title String
  normalizedProblemStatement String
  problemFingerprint String
  category String
  severity Int
  evidenceCount Int @default(0)
  sourceDiversity Int @default(0)
  urgency Int
  affectedAudience String
  affectedMarket String
  status String @default("potential")
  confidence Int
  recurringScore Int @default(0)
  recurringExplanation Json
  opportunityAnalysisId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  evidence ProblemEvidence[]
  prospects ProspectProblem[]
  opportunityAnalysis OpportunityRecord? @relation(fields:[opportunityAnalysisId],references:[id],onDelete:SetNull)
  @@unique([userId,problemFingerprint])
  @@index([userId,createdAt])
  @@index([userId,status])
  @@index([userId,category])
  @@index([userId,recurringScore])
}

model ProblemEvidence {
  id String @id @default(cuid())
  userId String
  problemId String
  sourceId String?
  externalReference String?
  title String
  summary String
  observedAt DateTime
  sourceType String
  fingerprint String
  evidenceConfidence Int
  severity Int
  urgency Int
  solutionFit Int
  businessValueHypothesis Int
  sourceReference String?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  problem DiscoveredProblem @relation(fields:[problemId],references:[id],onDelete:Cascade)
  @@unique([userId,fingerprint])
  @@index([userId,problemId,observedAt])
  @@index([userId,sourceId])
}

model Prospect {
  id String @id @default(cuid())
  userId String
  type String
  displayName String?
  organizationName String?
  publicReference String?
  sourceReference String?
  roleCategory String?
  evidenceCount Int @default(0)
  fingerprint String
  confidence Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  problems ProspectProblem[]
  @@unique([userId,fingerprint])
  @@index([userId,createdAt])
  @@index([userId,type])
}

model ProspectProblem {
  prospectId String
  problemId String
  evidenceCount Int @default(0)
  qualificationScore Int @default(0)
  qualificationLevel String @default("LOW")
  reasons Json
  confidence Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  prospect Prospect @relation(fields:[prospectId],references:[id],onDelete:Cascade)
  problem DiscoveredProblem @relation(fields:[problemId],references:[id],onDelete:Cascade)
  @@id([prospectId,problemId])
  @@index([problemId,qualificationScore])
}

model SourceIntelligenceReview {
  id String @id @default(cuid())
  userId String
  sourceId String
  rationale String?
  priority String?
  accessStatus String?
  implementationNotes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,sourceId])
  @@index([userId,updatedAt])
}

model DiagnosisTarget {
  id String @id @default(cuid())
  userId String
  url String
  targetType String
  hostname String
  protocol String
  normalizedUrl String
  displayName String?
  healthEndpoint String?
  apiEndpoint String?
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  runs DiagnosisRun[]
  findings DiagnosticFinding[]
  @@unique([userId,normalizedUrl])
  @@index([userId,createdAt])
}
model DiagnosisRun {
  id String @id @default(cuid())
  userId String
  targetId String
  status String
  overallStatus String?
  startedAt DateTime @default(now())
  completedAt DateTime?
  totalFindings Int @default(0)
  checksPerformed Json
  checksSkipped Json
  report Json
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  target DiagnosisTarget @relation(fields:[targetId],references:[id],onDelete:Cascade)
  findings DiagnosticFinding[]
  repairPlans RepairPlan[]
  @@index([userId,createdAt])
  @@index([userId,targetId])
}
model DiagnosticFinding {
  id String @id @default(cuid())
  userId String
  targetId String
  runId String
  category String
  title String
  description String
  severity String
  status String
  observedValue String?
  expectedValue String?
  evidence Json
  rootCauseHypothesis String?
  confidence Int
  facts Json
  hypotheses Json
  unknowns Json
  recommendation String
  estimatedEffortMinutes Int
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  target DiagnosisTarget @relation(fields:[targetId],references:[id],onDelete:Cascade)
  run DiagnosisRun @relation(fields:[runId],references:[id],onDelete:Cascade)
  repairStepFindings RepairStepFinding[]
  @@index([userId,runId])
  @@index([userId,targetId])
  @@index([userId,severity])
}

model RepairPlan {
  id String @id @default(cuid())
  userId String
  diagnosisRunId String
  title String
  summary String
  status String @default("DRAFT")
  overallRisk String
  estimatedEffortMinutes Int
  estimatedEffortRange String
  confidence Int
  facts Json
  hypotheses Json
  unknowns Json
  assumptions Json
  limitations Json
  requiresApproval Boolean @default(true)
  approvalStatus String @default("PENDING")
  approvedAt DateTime?
  approvedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  diagnosisRun DiagnosisRun @relation(fields:[diagnosisRunId],references:[id],onDelete:Cascade)
  steps RepairStep[]
  repairExecutions RepairExecution[]
  @@index([userId,createdAt])
  @@index([userId,diagnosisRunId])
  @@index([userId,status])
}

model RepairStep {
  id String @id @default(cuid())
  repairPlanId String
  order Int
  title String
  description String
  objective String
  category String
  affectedArea String
  dependencies Json
  evidence Json
  risk String
  estimatedEffortMinutes Int
  verificationMethod String
  rollbackAction String
  requiresApproval Boolean @default(true)
  createdAt DateTime @default(now())
  repairPlan RepairPlan @relation(fields:[repairPlanId],references:[id],onDelete:Cascade)
  findings RepairStepFinding[]
  @@unique([repairPlanId,order])
  @@index([repairPlanId])
}

model RepairStepFinding {
  repairStepId String
  findingId String
  repairStep RepairStep @relation(fields:[repairStepId],references:[id],onDelete:Cascade)
  finding DiagnosticFinding @relation(fields:[findingId],references:[id],onDelete:Cascade)
  @@id([repairStepId,findingId])
  @@index([findingId])
}


model AuthorizedRepository {
  id String @id @default(cuid())
  userId String
  name String
  provider String @default("LOCAL")
  repositoryIdentifier String
  repositoryOwner String?
  repositoryName String?
  workspaceRef String @unique
  defaultBranch String @default("main")
  allowedBranches Json
  authorizationStatus String @default("ACTIVE")
  grantedScopes Json
  githubRepositoryId String?
  installationId String?
  authorizedAt DateTime?
  revokedAt DateTime?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  executions RepairExecution[]
  @@index([userId,createdAt])
  @@index([userId,status])
  @@index([userId,provider,authorizationStatus])
  @@unique([userId,provider,repositoryIdentifier])
}

model RepairExecution {
  id String @id @default(cuid())
  userId String
  repairPlanId String
  authorizedRepositoryId String
  status String @default("PENDING")
  authorizationStatus String @default("NOT_AUTHORIZED")
  workspaceId String?
  branchName String?
  startedAt DateTime?
  completedAt DateTime?
  error String?
  summary String?
  authorizedAt DateTime?
  authorizedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  repairPlan RepairPlan @relation(fields:[repairPlanId],references:[id],onDelete:Cascade)
  authorizedRepository AuthorizedRepository @relation(fields:[authorizedRepositoryId],references:[id],onDelete:Cascade)
  events RepairExecutionEvent[]
  changes RepairChange[]
  tests RepairTestResult[]
  verifications RepairVerificationResult[]
  repairReviews RepairReview[]
  @@index([userId,createdAt])
  @@index([userId,status])
  @@index([userId,repairPlanId])
  @@index([userId,authorizationStatus])
}

model RepairExecutionEvent {
  id String @id @default(cuid())
  executionId String
  eventType String
  repairStepId String?
  message String
  status String
  createdAt DateTime @default(now())
  execution RepairExecution @relation(fields:[executionId],references:[id],onDelete:Cascade)
  @@index([executionId,createdAt])
}

model RepairChange {
  id String @id @default(cuid())
  executionId String
  repairStepId String?
  filePath String
  changeType String
  reason String
  validationResult String?
  createdAt DateTime @default(now())
  execution RepairExecution @relation(fields:[executionId],references:[id],onDelete:Cascade)
  @@index([executionId,createdAt])
}

model RepairTestResult {
  id String @id @default(cuid())
  executionId String
  repairStepId String?
  command String
  status String
  outputSummary String?
  startedAt DateTime
  completedAt DateTime?
  execution RepairExecution @relation(fields:[executionId],references:[id],onDelete:Cascade)
  @@index([executionId,startedAt])
  @@index([executionId,status])
}

model RepairVerificationResult {
  id String @id @default(cuid())
  executionId String
  repairStepId String?
  method String
  status String
  details String
  createdAt DateTime @default(now())
  execution RepairExecution @relation(fields:[executionId],references:[id],onDelete:Cascade)
  @@index([executionId,createdAt])
}

model RepairReview {
  id String @id @default(cuid())
  userId String
  executionId String
  status String @default("COMPLETED")
  verdict String
  reviewerType String @default("DETERMINISTIC_PLUS_AI")
  summary String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  execution RepairExecution @relation(fields:[executionId],references:[id],onDelete:Cascade)
  findings RepairReviewFinding[]
  @@unique([executionId])
  @@index([userId,createdAt])
  @@index([userId,verdict])
}

model RepairReviewFinding {
  id String @id @default(cuid())
  reviewId String
  category String
  severity String
  title String
  description String
  evidence String
  filePath String?
  ruleId String
  blocking Boolean @default(false)
  recommendation String
  source String @default("DETERMINISTIC")
  createdAt DateTime @default(now())
  review RepairReview @relation(fields:[reviewId],references:[id],onDelete:Cascade)
  @@index([reviewId,createdAt])
  @@index([reviewId,blocking])
  @@index([severity])
}

model GithubAuthorizationState {
  id String @id @default(cuid())
  userId String
  stateHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  installationId String?
  availableInstallations Json @default("[]")
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,expiresAt])
  @@index([expiresAt])
}
