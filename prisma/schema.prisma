generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String?
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     Session[]
  analyses     AnalysisRecord[]
  solverRuns   SolverRecord[]
  opportunities OpportunityRecord[]
  intelligenceSignals IntelligenceSignal[]
  sources Source[]

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AnalysisRecord {
  id           String   @id @default(cuid())
  userId       String
  itemId       String
  opportunity  String
  confidence   Int
  whyItMatters String
  nextSteps    Json
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, itemId])
}

model SolverRecord {
  id        String   @id @default(cuid())
  userId    String
  problem   String
  summary   String
  steps     Json
  risks     Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model OpportunityRecord {
  id String @id @default(cuid())
  userId String
  input String
  title String
  shortSummary String
  problemStatement String
  targetUsers Json
  marketDomain String
  painSeverity Int
  demandSignals Json
  existingAlternatives Json
  proposedSolutionDirection String
  monetizationPossibilities Json
  estimatedDifficulty Int
  technicalFeasibility Int
  businessPotential Int
  risks Json
  assumptions Json
  unknowns Json
  recommendedNextStep String
  dimensionScores Json
  dimensionExplanations Json
  overallScore Int
  confidence Int
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt])
  @@index([userId,overallScore])
}


model IntelligenceSignal {
  id String @id @default(cuid())
  userId String
  title String
  summary String
  sourceType String
  sourceName String
  sourceUrl String?
  externalId String?
  detectedAt DateTime
  receivedAt DateTime
  topic String
  entities Json
  signalType String
  rawContent String
  rawReference String?
  normalizedContent String
  sourceFacts Json
  aiInterpretation Json
  assumptions Json
  unknowns Json
  confidence Int
  metadata Json
  fingerprint String
  opportunityAnalysisStatus String @default("not_analyzed")
  lastOpportunityAnalyzedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,fingerprint])
  @@index([userId,sourceType,createdAt])
  @@index([userId,receivedAt])
  @@index([userId,topic])
  @@index([userId,signalType])
}


model Source {
  id String @id
  userId String
  name String
  type String
  enabled Boolean @default(true)
  status String @default("UNKNOWN")
  description String
  config Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  health SourceHealth?
  @@unique([userId,name])
  @@index([userId,enabled])
  @@index([userId,type])
}

model SourceHealth {
  id String @id @default(cuid())
  sourceId String @unique
  lastCheckAt DateTime?
  lastSuccessAt DateTime?
  totalChecks Int @default(0)
  totalFailures Int @default(0)
  lastError String?
  latencyMs Int?
  healthScore Int @default(0)
  status String @default("UNKNOWN")
  updatedAt DateTime @updatedAt
  source Source @relation(fields:[sourceId],references:[id],onDelete:Cascade)
  @@index([status])
  @@index([updatedAt])
}
